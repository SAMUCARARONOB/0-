        local function render(anim)
            local targetColor = state and THEME.Accent or THEME.Surface
            local targetKnobPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            local targetKnobColor = state and Color3.new(1,1,1) or THEME.TextSecondary
            local targetStroke = state and THEME.AccentLight or THEME.Border
            local dur = anim and 0.25 or 0
            tween(sw, TweenInfo.new(dur, Enum.EasingStyle.Quad), { BackgroundColor3 = targetColor })
            tween(swStroke, TweenInfo.new(dur, Enum.EasingStyle.Quad), { Color = targetStroke, Transparency = state and 0.1 or 0.3 })
            tween(knob, TweenInfo.new(dur, Enum.EasingStyle.Quad), { Position = targetKnobPos, BackgroundColor3 = targetKnobColor })
        end
        render(false)
        
        sw.MouseButton1Click:Connect(function()
            state = not state
            render(true)
            if cfg.Callback then pcall(cfg.Callback, state) end
        end)
        row.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if input.Position.X < sw.AbsolutePosition.X then
                    state = not state
                    render(true)
                    if cfg.Callback then pcall(cfg.Callback, state) end
                end
            end
        end)
    end
    
