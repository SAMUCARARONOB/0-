            BackgroundTransparency = 1, Text = cfg.Default or "Selecione...",
            TextColor3 = THEME.AccentLight, TextSize = 12, Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Right, Parent = topRow,
        })
        local arrow = new("TextLabel", {
            Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -30, 0.5, -10),
            BackgroundTransparency = 1, Text = "▾",
            TextColor3 = THEME.TextSecondary, TextSize = 14, Font = Enum.Font.GothamBold,
            Parent = topRow,
        })
        
        -- List (flutuante)
        local list = new("ScrollingFrame", {
            Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(0, 0, 1, 4),
            BackgroundColor3 = THEME.Surface,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            Visible = false,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = THEME.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 10,
            Parent = holder,
        })
        corner(list, 8)
        stroke(list, THEME.Accent, 1.5, 0.2)
        padding(list, 6, 6, 6, 6)
        listLayout(list, 3)
        
        local isOpen = false
        for i, opt in ipairs(options) do
            local optBtn = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundColor3 = THEME.SurfaceHigh,
                BackgroundTransparency = 0.4,
                Text = opt,
                TextColor3 = THEME.TextPrimary,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                LayoutOrder = i,
                ZIndex = 11,
                Parent = list,
            })
            corner(optBtn, 6)
            optBtn.MouseEnter:Connect(function()
                fast(optBtn, { BackgroundColor3 = THEME.Accent, BackgroundTransparency = 0.3 })
            end)
            optBtn.MouseLeave:Connect(function()
                fast(optBtn, { BackgroundColor3 = THEME.SurfaceHigh, BackgroundTransparency = 0.4 })
            end)
            optBtn.MouseButton1Click:Connect(function()
                valueLabel.Text = opt
                isOpen = false
                list.Visible = false
                smooth(list, { Size = UDim2.new(1, 0, 0, 0) }, 0.2)
                smooth(arrow, { Rotation = 0 }, 0.2)
                if cfg.Callback then pcall(cfg.Callback, opt) end
            end)
        end
        
        topRow.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            list.Visible = true
            local h = math.min(#options * 33 + 12, 200)
            smooth(list, { Size = UDim2.new(1, 0, 0, isOpen and h or 0) }, 0.25)
            smooth(arrow, { Rotation = isOpen and 180 or 0 }, 0.2)
            fast(hs, { Color = isOpen and THEME.Accent or THEME.Border })
            if not isOpen then
                task.delay(0.25, function()
                    if not isOpen then list.Visible = false end
                end)
            end
        end)
        
        -- Extende o holder dinamicamente quando aberto
        local function resize()
            local listH = list.Visible and list.Size.Y.Offset or 0
            holder.Size = UDim2.new(1, -4, 0, 40 + listH)
        end
        list:GetPropertyChangedSignal("Size"):Connect(resize)
        list:GetPropertyChangedSignal("Visible"):Connect(resize)
    end
    
