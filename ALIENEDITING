            local isActive = (n == name)
            fast(label, { TextColor3 = isActive and THEME.TextPrimary or THEME.TextSecondary })
            fast(btn.Icon, { ImageColor3 = isActive and THEME.AccentLight or THEME.TextMuted })
            fast(btn.IconBg, { BackgroundColor3 = isActive and THEME.Accent or THEME.SurfaceHigh })
        end
        CurrentTab = name
    end
    
    function Window:CreateTab(tabName, iconId)
