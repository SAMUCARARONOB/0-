        local presets = {
            { Color3.fromRGB(140, 40, 220), Color3.fromRGB(0, 200, 255) },  -- Roxo/Ciano (default)
            { Color3.fromRGB(230, 40, 60),  Color3.fromRGB(255, 140, 0) },  -- Vermelho/Laranja
            { Color3.fromRGB(0, 200, 100),  Color3.fromRGB(0, 220, 220) },  -- Verde/Água
            { Color3.fromRGB(0, 120, 255),  Color3.fromRGB(140, 40, 220) }, -- Azul/Roxo
            { Color3.fromRGB(255, 180, 0),  Color3.fromRGB(255, 80, 80) },  -- Dourado/Vermelho
            { Color3.fromRGB(255, 60, 180), Color3.fromRGB(140, 40, 220) }, -- Rosa/Roxo
            { Color3.fromRGB(0, 220, 130),  Color3.fromRGB(0, 120, 255) },  -- Verde/Azul
            { Color3.fromRGB(200, 200, 220), Color3.fromRGB(80, 80, 120) }, -- Prata
        }
        
        local wrap = new("Frame", {
            Size = UDim2.new(1, -4, 0, 0),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y,
            Parent = page,
        })
        local grid = new("UIGridLayout", {
            CellSize = UDim2.new(0, 48, 0, 48),
            CellPadding = UDim2.new(0, 8, 0, 8),
            FillDirection = Enum.FillDirection.Horizontal,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = wrap,
        })
        
        for i, pair in ipairs(presets) do
            local c = new("TextButton", {
                Size = UDim2.new(0, 48, 0, 48), BackgroundColor3 = pair[1],
                Text = "", AutoButtonColor = false, BorderSizePixel = 0,
                LayoutOrder = i, Parent = wrap,
            })
            corner(c, 10)
            stroke(c, pair[2], 1.5, 0.3)
            new("UIGradient", { Color = ColorSequence.new(pair[1], pair[2]), Rotation = 45, Parent = c })
            
            c.MouseEnter:Connect(function() fast(c, { Size = UDim2.new(0, 54, 0, 54) }) end)
            c.MouseLeave:Connect(function() fast(c, { Size = UDim2.new(0, 48, 0, 48) }) end)
            c.MouseButton1Click:Connect(function()
                THEME.Accent = pair[1]
                THEME.AccentLight = pair[1]:Lerp(Color3.new(1,1,1), 0.3)
                THEME.Accent2 = pair[2]
                -- Atualiza todos os elementos com accent (via stroke)
                for _, d in ipairs(Main:GetDescendants()) do
                    if d:IsA("UIStroke") and d.Color == THEME.Accent then
                        d.Color = pair[1]
                    end
                end
            end)
        end
    end
    
