            Text = "255.0.0", PlaceholderText = "R.G.B",
            PlaceholderColor3 = THEME.TextMuted,
            TextColor3 = THEME.TextPrimary, TextSize = 12, Font = Enum.Font.Gotham,
            ClearTextOnFocus = false, Parent = expandArea,
        })
        corner(input, 6)
        stroke(input, THEME.Border, 1, 0.5)
        
        local r, g, b = 1, 0, 0
        local function apply()
            local c = Color3.fromRGB(r*255, g*255, b*255)
            preview.BackgroundColor3 = c
            valueBar.BackgroundColor3 = c
            if cfg.Callback then pcall(cfg.Callback, c) end
        end
        
        local function updateFromInput()
            local rr, gg, bb = input.Text:match("(%d+)%.(%d+)%.(%d+)")
            if rr and gg and bb then
                r, g, b = tonumber(rr)/255, tonumber(gg)/255, tonumber(bb)/255
                apply()
            end
        end
        input.FocusLost:Connect(function(enter) if enter then updateFromInput() end end)
        -- Atualiza conforme digita (se 3 números válidos)
        input:GetPropertyChangedSignal("Text"):Connect(function()
            local rr, gg, bb = input.Text:match("(%d+)%.(%d+)%.(%d+)")
            if rr and gg and bb then updateFromInput() end
        end)
        
        -- drag hue
        local dragHue = false
        local function updateHue(x)
            local rel = math.clamp((x - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
            hueKnob.Position = UDim2.new(rel, -2, 0.5, -11)
            local c = Color3.fromHSV(rel, 1, 1)
            r, g, b = c.R, c.G, c.B
            valueBar.BackgroundColor3 = c
            preview.BackgroundColor3 = c
            input.Text = math.floor(r*255) .. "." .. math.floor(g*255) .. "." .. math.floor(b*255)
            apply()
        end
        hueBar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragHue = true; updateHue(i.Position.X)
            end
        end)
        UserInput.InputChanged:Connect(function(i)
            if dragHue and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                updateHue(i.Position.X)
            end
        end)
        UserInput.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragHue = false
            end
        end)
        
        local open = false
        local function resize()
            local targetH = open and 92 or 0
            holder.Size = UDim2.new(1, -4, 0, 40 + targetH)
            expandArea.Size = UDim2.new(1, 0, 0, targetH)
        end
        topRow.MouseButton1Click:Connect(function()
            open = not open
            resize()
        end)
    end
    
