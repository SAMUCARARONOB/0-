            Size = UDim2.new(1, -70, 0, 30), Position = UDim2.new(0, 58, 0, 34),
            BackgroundTransparency = 1, Text = text,
            TextColor3 = THEME.TextSecondary, TextSize = 11, Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Parent = toast,
        })
        
        -- Slide in
        tween(toast, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -20, 1, -20),
        })
        task.delay(2.5, function()
            tween(toast, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                Position = UDim2.new(1, 320, 1, -30),
            })
            task.delay(0.4, function() toast:Destroy() end)
        end)
