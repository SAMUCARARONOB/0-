            Name = tabName,
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            Visible = false,
            AutomaticSize = Enum.AutomaticSize.Y,
            Parent = Content,
        })
        listLayout(page, 8)
        Pages[tabName] = page
        
        local btn = new("TextButton", {
            Name = tabName,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = THEME.Surface,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = Sidebar,
        })
        corner(btn, 8)
        
        -- Icon container
        local iconBg = new("Frame", {
            Name = "IconBg",
            Size = UDim2.new(0, 22, 0, 22),
            Position = UDim2.new(0, 8, 0.5, -11),
            BackgroundColor3 = THEME.SurfaceHigh,
            BorderSizePixel = 0,
            ZIndex = 4,
            Parent = btn,
        })
        corner(iconBg, 6)
        
        local icon = new("ImageLabel", {
            Name = "Icon",
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1,
            Image = iconId and ("rbxassetid://" .. tostring(iconId)) or "rbxassetid://10709796736",
            ImageColor3 = THEME.TextMuted,
            ZIndex = 5,
            Parent = iconBg,
        })
        
        new("TextLabel", {
            Size = UDim2.new(1, -40, 1, 0),
            Position = UDim2.new(0, 38, 0, 0),
            BackgroundTransparency = 1,
            Text = tabName,
            TextColor3 = THEME.TextSecondary,
            TextSize = 12,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
            Parent = btn,
        })
        
        TabButtons[tabName] = btn
        
        btn.MouseEnter:Connect(function()
            if CurrentTab ~= tabName then
                fast(btn, { BackgroundColor3 = THEME.SurfaceHigh, BackgroundTransparency = 0.5 })
            end
        end)
        btn.MouseLeave:Connect(function()
            if CurrentTab ~= tabName then
                fast(btn, { BackgroundColor3 = THEME.Surface, BackgroundTransparency = 1 })
            end
        end)
        
        btn.MouseButton1Click:Connect(function()
            -- Move indicator
            TabIndicator.Visible = true
            smooth(TabIndicator, {
                Position = UDim2.new(0, 0, 0, btn.AbsolutePosition.Y - Sidebar.AbsolutePosition.Y),
                Size = UDim2.new(1, 0, 0, btn.AbsoluteSize.Y),
            }, 0.3)
            switchTo(tabName)
        end)
        
        if not CurrentTab then
            task.defer(function()
                task.wait(0.15)
                btn.MouseButton1Click:Fire()
            end)
        end
        
        return page
    end
    
