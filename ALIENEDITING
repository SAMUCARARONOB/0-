            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new(0, 3, 0.5, -8),
            BackgroundColor3 = THEME.TextSecondary,
            BorderSizePixel = 0,
            Parent = sw,
        })
        corner(knob, 999)
        
